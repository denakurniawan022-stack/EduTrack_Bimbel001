  const t=tutors.find(x=>x.id===tutorId)||{name:''};
  const list=DB.get('siswa')||[];
  const entry={id,nama,ortu,tutorId,tutorNama:t.name,level,tipe,tglDaftar,status};
  if(existingId){
    const idx=list.findIndex(s=>s.id===existingId);
    if(idx!==-1) list[idx]={...list[idx],...entry};
  } else {
    list.push({no:list.length+1,...entry});
  }
  await DB.set('siswa',list);
  closeModal();
  showToast(existingId?'Data siswa diperbarui ✅':'Siswa baru ditambahkan ✅','ok');
  loadSiswa();
}

