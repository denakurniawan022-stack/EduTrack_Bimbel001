function handleFoto(input){
  if(!input.files||!input.files[0]) return;
  const file=input.files[0];
  if(file.size>10*1024*1024){showToast('Ukuran foto maks 10MB','err');return;}
  const reader=new FileReader();
  reader.onload=e=>{
    const img=new Image();
    img.onload=()=>{
      const canvas=document.createElement('canvas');
      let w=img.width,h=img.height,MAX=800;
      if(w>h&&w>MAX){h=Math.round(h*MAX/w);w=MAX;}
      else if(h>MAX){w=Math.round(w*MAX/h);h=MAX;}
      canvas.width=w;canvas.height=h;
      canvas.getContext('2d').drawImage(img,0,0,w,h);
      const b64=canvas.toDataURL('image/jpeg',0.75);
      document.getElementById('m-foto-b64').value=b64;
      const area=document.getElementById('photo-area');
      area.classList.add('has-photo');
      area.innerHTML=`<img src="${b64}" class="photo-thumb"><div style="font-size:12px;color:var(--teal);margin-top:6px">✅ ${file.name}</div>
        <div style="font-size:11px;color:var(--text-3);margin-top:2px">Klik untuk ganti foto</div>`;
    };
    img.src=e.target.result;
  };
  reader.readAsDataURL(file);
}

async function submitAbsensi(){
  const isAdmin=APP.role==='admin';
  const tutorEl=document.getElementById('m-tutor');
  const tutorId=tutorEl?tutorEl.value:APP.user.id;
  const tutors=DB.get('tutors')||[];
  const t=tutors.find(x=>x.id===tutorId)||{name:APP.user.name};
  const tutorNama=t.name;

  const tanggal=document.getElementById('m-tgl').value;
  const status=document.getElementById('m-status').value;
  const namaSiswa=document.getElementById('m-siswa').value.trim();
  const jmlSiswa=parseInt(document.getElementById('m-jml').value)||1;
  const mapel=document.getElementById('m-mapel').value.trim();
  const level=document.getElementById('m-level').value;
  const tipe=document.getElementById('m-tipe').value;
  const durasi=parseInt(document.getElementById('m-durasi').value)||60;
  const b64=document.getElementById('m-foto-b64').value;
  const fotoUrl=document.getElementById('m-foto-url').value;
  const rowIndex=document.getElementById('m-rowindex').value;
  const no=document.getElementById('m-no').value;

  if(!tanggal||!namaSiswa||!mapel){showToast('Tanggal, nama siswa & mapel wajib diisi','err');return;}
  if(!b64&&!fotoUrl){showToast('Foto bukti wajib diupload','err');return;}

  // Hitung komisi
  const tarif=DB.get('tarif')||{};
  const tr=(tarif[tutorId]||{});
  const key=tipe==='Privat'?'privat':'reguler';
  let komisi=0;
  if(status==='Hadir'){
    const perSesi=((tr[key]||{})[level])||0;
    komisi=jmlSiswa>1?perSesi*jmlSiswa:perSesi;
  }

  const finalFoto=b64||fotoUrl;
  const absensi=DB.get('absensi')||[];

  if(rowIndex){
    const idx=absensi.findIndex(a=>a.rowIndex===parseInt(rowIndex));
    if(idx!==-1){
      absensi[idx]={...absensi[idx],tanggal,tutorId,tutorNama,namaSiswa,jmlSiswa,mapel,level,tipe,durasi,status,komisi,fotoUrl:finalFoto};
    }
  } else {
    const newIdx=Math.max(0,...absensi.map(a=>a.rowIndex||0))+1;
    absensi.push({rowIndex:newIdx,no:newIdx,tanggal,tutorId,tutorNama,namaSiswa,jmlSiswa,mapel,level,tipe,durasi,status,komisi,fotoUrl:finalFoto});
  }

  DB.set('absensi',absensi);
  closeModal();
  showToast(rowIndex?'Absensi diperbarui ✅':'Absensi dicatat ✅ Komisi: '+fmtRp(komisi),'ok');
  loadAbsensi();
}

async function hapusAbsensi(rowIndex){
  if(!confirm('Yakin hapus absensi ini?')) return;
  const absensi=(DB.get('absensi')||[]).filter(a=>a.rowIndex!==rowIndex);
  await DB.set('absensi',absensi);
  showToast('Absensi dihapus','ok');
  loadAbsensi();
}

