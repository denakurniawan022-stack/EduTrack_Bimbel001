    const tglBayar=pay?.tglBayar||'-';
    return `<tr>
      <td><div style="font-weight:600;color:var(--navy)">${r.name}</div></td>
      <td style="text-align:right;font-family:var(--mono);font-weight:600">${fmtRp(r.totalKomisi)}</td>
      <td style="text-align:center">${badge(status)}</td>
