function badge(val){
  const map={
    'Hadir':'bg-green','Aktif':'bg-green','Sudah Dibayar':'bg-green',
    'Privat':'bg-amber','Belum Dibayar':'bg-red','Diproses':'bg-amber',
    'Reguler':'bg-blue',
