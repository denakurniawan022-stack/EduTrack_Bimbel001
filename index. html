    'Izin-Siswa':'bg-amber','Izin-Tutor':'bg-amber',
    'Alpha':'bg-red','Non-Aktif':'bg-red','Cuti':'bg-gray',
    'TK':'bg-amber','Libur':'bg-gray'
  };
  return `<span class="badge ${map[val]||'bg-gray'}">${val}</span>`;
}
function dotCls(s){
  if(s==='Hadir') return 'dot-hadir';
  if(s&&s.includes('Izin')) return 'dot-izin';
  if(s==='Alpha') return 'dot-alpha';
  return 'dot-libur';
}

