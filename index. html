      <td style="text-align:center">
        <button class="btn btn-${status==='Sudah Dibayar'?'outline':'teal'} btn-sm" 
          onclick="showModalBayar('${r.id}','${r.name}','${periodeLabel}',${r.totalKomisi},'${status}')">
