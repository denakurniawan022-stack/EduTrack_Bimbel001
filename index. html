function loadRekap(){
  const bulan=parseInt(document.getElementById('r-bulan')?.value||0);
  const tahun=parseInt(document.getElementById('r-tahun')?.value||0);
  const dari=document.getElementById('r-dari')?.value||'';
  const sampai=document.getElementById('r-sampai')?.value||'';
  const tutorFilter=document.getElementById('r-tutor')?.value||'';
  const isAdmin=APP.role==='admin';

  let absensi=DB.get('absensi')||[];

  // Filter tanggal
  if(dari||sampai){
    absensi=absensi.filter(a=>{
      if(dari&&a.tanggal<dari) return false;
      if(sampai&&a.tanggal>sampai) return false;
      return true;
    });
  } else {
    absensi=absensi.filter(a=>{
      const [y,m]=a.tanggal.split('-');
      return parseInt(m)===bulan&&parseInt(y)===tahun;
    });
  }

  const periodeLabel=(dari||sampai)
    ? `${dari||'...'} s/d ${sampai||'...'}`
    : `${MONTHS[bulan]} ${tahun}`;

  let tutors=DB.get('tutors')||[];
  if(!isAdmin) tutors=tutors.filter(t=>t.id===APP.user.id);
  else if(tutorFilter) tutors=tutors.filter(t=>t.id===tutorFilter);

  // Rekap per tutor
  const rekap=tutors.map(t=>{
    const tab=absensi.filter(a=>a.tutorId===t.id);
    const hadir=tab.filter(a=>a.status==='Hadir');
    const izin=tab.filter(a=>a.status.includes('Izin')).length;
    const alpha=tab.filter(a=>a.status==='Alpha').length;
    const komisiP={TK:0,SD:0,SMP:0,SMA:0};
    const komisiR={TK:0,SD:0,SMP:0,SMA:0};
    const sesiP={TK:0,SD:0,SMP:0,SMA:0};
    const sesiR={TK:0,SD:0,SMP:0,SMA:0};
    hadir.forEach(a=>{
      if(!LEVELS.includes(a.level)) return;
      const k=Number(a.komisi||0);
      if(a.tipe==='Privat'){komisiP[a.level]+=k;sesiP[a.level]++;}
      else{komisiR[a.level]+=k;sesiR[a.level]++;}
    });
    return{
      id:t.id,name:t.name,mapel:t.mapel,
      hadir:hadir.length,izin,alpha,
      totalKomisi:hadir.reduce((s,a)=>s+Number(a.komisi||0),0),
      totalJam:hadir.reduce((s,a)=>s+Number(a.durasi||0),0),
      komisiP,komisiR,sesiP,sesiR
    };
  });

  const grandP={TK:0,SD:0,SMP:0,SMA:0},grandR={TK:0,SD:0,SMP:0,SMA:0};
  let grandSesi=0,grandTotal=0;
  rekap.forEach(r=>{
    LEVELS.forEach(lv=>{grandP[lv]+=r.komisiP[lv];grandR[lv]+=r.komisiR[lv];});
    grandSesi+=r.hadir;grandTotal+=r.totalKomisi;
  });

  const lcColors={TK:'#E65100',SD:'#0F6E56',SMP:'#185FA5',SMA:'#854F0B'};

  const wrap=document.getElementById('rekap-content');
  if(!wrap) return;

  if(!isAdmin&&rekap.length===1){
    // Tampilan tutor — detail per level
    const r=rekap[0];
    wrap.innerHTML=`
      <div class="komisi-banner">
        <div class="k-left">
          <div class="k-label">Total Komisi — ${periodeLabel}</div>
          <div class="k-val">${fmtRp(r.totalKomisi)}</div>
          <div class="k-sub">${r.hadir} sesi hadir · ${r.totalJam} menit</div>
