// TARIF
// ═══════════════════════════════════════════════════════════════
function renderTarif(){
  document.getElementById('main-content').innerHTML=`
    <div class="page-header">
      <div><div class="page-title">💰 Tarif Komisi</div>
      <div class="page-sub">Tarif per sesi per level untuk setiap tutor</div></div>
    </div>
    <div id="tarif-content"><div class="spinner"></div></div>`;
  loadTarif();
}

function loadTarif(){
  const tutors=DB.get('tutors')||[];
  const tarif=DB.get('tarif')||{};
  const el=document.getElementById('tarif-content');
  if(!el) return;

  el.innerHTML=tutors.map(t=>{
    const tr=tarif[t.id]||{privat:{},reguler:{}};
    return `<div class="card">
      <div class="card-title">
        <div class="card-title-left">
          <div class="av-circle" style="background:${strColor(t.name)};font-size:12px">${t.name.charAt(0)}</div>
          <div>
            <div>${t.name}</div>
            <div style="font-size:11px;color:var(--text-3);font-weight:400">${t.mapel} · ${t.level}</div>
          </div>
        </div>
        <button class="btn btn-amber btn-sm" onclick="showModalTarif('${t.id}','${t.name}')">✏️ Edit Tarif</button>
      </div>
      <div class="tarif-matrix">
        <div class="tmat-lbl">Privat</div>
        ${LEVELS.map(lv=>`<div class="tmat-h">${lv}<br><span style="font-weight:400;font-size:11px">${fmtRp((tr.privat||{})[lv]||0)}</span></div>`).join('')}
        <div class="tmat-lbl">Reguler</div>
        ${LEVELS.map(lv=>`<div class="tmat-h" style="background:var(--teal)">${lv}<br><span style="font-weight:400;font-size:11px">${fmtRp((tr.reguler||{})[lv]||0)}</span></div>`).join('')}
      </div>
    </div>`;
  }).join('');
}

function showModalTarif(tid,tname){
  const tarif=DB.get('tarif')||{};
  const tr=tarif[tid]||{privat:{},reguler:{}};

  openModal(`
    <div class="modal-title">💰 Edit Tarif — ${tname}</div>
    <div style="font-size:12px;font-weight:700;color:var(--teal);text-transform:uppercase;letter-spacing:.4px;margin-bottom:12px">Privat (Rp per sesi)</div>
    <div class="form-grid">
      ${LEVELS.map(lv=>`<div class="form-group">
        <label>${lv}</label>
        <input type="number" class="form-control" id="tp-${lv}" value="${(tr.privat||{})[lv]||0}" min="0" step="5000">
      </div>`).join('')}
    </div>
    <div style="font-size:12px;font-weight:700;color:var(--navy);text-transform:uppercase;letter-spacing:.4px;margin:16px 0 12px">Reguler (Rp per sesi)</div>
    <div class="form-grid">
      ${LEVELS.map(lv=>`<div class="form-group">
        <label>${lv}</label>
        <input type="number" class="form-control" id="tr-${lv}" value="${(tr.reguler||{})[lv]||0}" min="0" step="5000">
      </div>`).join('')}
    </div>
    <div style="font-size:11px;color:var(--text-3);margin-top:8px">Isi 0 jika tutor tidak mengajar level tersebut</div>
    <div class="form-actions">
      <button class="btn btn-outline" onclick="closeModal()">Batal</button>
      <button class="btn btn-amber" onclick="submitTarif('${tid}')">💾 Simpan Tarif</button>
    </div>`);
}

async function submitTarif(tid){
  const tarif=DB.get('tarif')||{};
  const privat={},reguler={};
  LEVELS.forEach(lv=>{
    privat[lv]=parseInt(document.getElementById('tp-'+lv).value)||0;
    reguler[lv]=parseInt(document.getElementById('tr-'+lv).value)||0;
  });
  tarif[tid]={privat,reguler};
  await DB.set('tarif',tarif);
  closeModal();
  showToast('Tarif berhasil disimpan ✅','ok');
  loadTarif();
}

// ═══════════════════════════════════════════════════════════════
// MODAL UTILS
// ═══════════════════════════════════════════════════════════════
function openModal(html){
  document.getElementById('modal-content').innerHTML=html;
  document.getElementById('overlay').classList.add('open');
}
function closeModal(){
  document.getElementById('overlay').classList.remove('open');
}
function handleOverlayClick(e){
  if(e.target===document.getElementById('overlay')) closeModal();
}

// ═══════════════════════════════════════════════════════════════
// TOAST
// ═══════════════════════════════════════════════════════════════
let toastTimer;
function showToast(msg,type=''){
  document.getElementById('toast-el')?.remove();
  const d=document.createElement('div');
  d.id='toast-el';
  d.className=`toast ${type==='ok'?'ok':type==='err'?'err':''}`;
  d.innerHTML=`<span>${type==='ok'?'✅':type==='err'?'❌':'ℹ️'}</span>${msg}`;
  document.body.appendChild(d);
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>{d.style.opacity='0';setTimeout(()=>d.remove(),300);},3500);
}

// ═══════════════════════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════════════════════
function strColor(str){
  const colors=['#1A3557','#0F6E56','#854F0B','#A32D2D','#5B21B6','#0C444C','#1A4A2E','#7C3D00'];
  let h=0;
  for(let i=0;i<str.length;i++) h=str.charCodeAt(i)+((h<<5)-h);
  return colors[Math.abs(h)%colors.length];
}

