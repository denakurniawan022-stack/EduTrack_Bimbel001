function showModalBayar(tutorId,tutorNama,periode,totalKomisi,statusLama){
  openModal(`
    <div class="modal-title">💳 Pembayaran Komisi</div>
    <div style="background:var(--bg);border-radius:10px;padding:16px;margin-bottom:18px">
      <div style="font-size:11px;color:var(--text-3);text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px">Tutor</div>
      <div style="font-size:16px;font-weight:700;color:var(--navy)">${tutorNama}</div>
      <div style="font-size:12px;color:var(--text-2);margin-top:2px">Periode: ${periode}</div>
      <div style="font-size:24px;font-weight:700;color:var(--teal);margin-top:8px;font-family:var(--mono)">${fmtRp(totalKomisi)}</div>
    </div>
    <div class="form-group" style="margin-bottom:16px">
      <label>Status Pembayaran</label>
      <select class="form-control" id="pay-status">
        ${['Belum Dibayar','Diproses','Sudah Dibayar'].map(s=>`<option ${s===statusLama?'selected':''}>${s}</option>`).join('')}
      </select>
    </div>
    <div class="form-group" style="margin-bottom:16px">
      <label>📎 Bukti Transfer (Opsional)</label>
      <div class="photo-drop" onclick="document.getElementById('inp-bukti').click()">
        <div id="bukti-ph">📸 Klik untuk upload foto bukti</div>
      </div>
      <input type="file" id="inp-bukti" accept="image/*" style="display:none" onchange="handleBukti(this)">
      <input type="hidden" id="bukti-b64" value="">
    </div>
    <div class="form-actions">
      <button class="btn btn-outline" onclick="closeModal()">Batal</button>
      <button class="btn btn-teal" onclick="submitBayar('${tutorId}','${tutorNama}','${periode}',${totalKomisi})">💾 Simpan</button>
    </div>`);
}

function handleBukti(input){
  if(!input.files||!input.files[0]) return;
  const reader=new FileReader();
  reader.onload=e=>{
    document.getElementById('bukti-b64').value=e.target.result;
    document.getElementById('bukti-ph').innerHTML=`<div style="color:var(--teal)">✅ Foto dipilih</div>`;
  };
  reader.readAsDataURL(input.files[0]);
}

async function submitBayar(tutorId,tutorNama,periode,totalKomisi){
  const status=document.getElementById('pay-status').value;
  const bukti=document.getElementById('bukti-b64').value;
  const tglBayar=status==='Sudah Dibayar'?new Date().toISOString().split('T')[0]:'';
  const payments=DB.get('pembayaran')||[];
  const idx=payments.findIndex(p=>p.tutorId===tutorId&&p.periode===periode);
  const entry={tutorId,tutorNama,periode,totalKomisi,status,buktiUrl:bukti,tglBayar};
  if(idx!==-1) payments[idx]=entry;
  else payments.push(entry);
  await DB.set('pembayaran',payments);
  closeModal();
  showToast('Status pembayaran disimpan ✅','ok');
  loadRekap();
}

