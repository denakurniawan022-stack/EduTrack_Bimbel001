async function submitTutor(existingId){
  const id=document.getElementById('mt-id').value.trim();
  const name=document.getElementById('mt-name').value.trim();
  const username=document.getElementById('mt-user').value.trim();
  const pass=document.getElementById('mt-pass').value.trim();
  const mapel=document.getElementById('mt-mapel').value.trim();
  const level=document.getElementById('mt-level').value.trim();
  const status=document.getElementById('mt-status').value;
  const catatan=document.getElementById('mt-catatan').value.trim();

  if(!id||!name||!username){showToast('ID, Nama, dan Username wajib diisi','err');return;}

  const tutors=DB.get('tutors')||[];
  if(existingId){
    const idx=tutors.findIndex(t=>t.id===existingId);
    if(idx!==-1) tutors[idx]={...tutors[idx],name,username,pass:pass||tutors[idx].pass,mapel,level,status,catatan};
  } else {
    if(tutors.find(t=>t.id===id)){showToast('ID sudah digunakan','err');return;}
    tutors.push({no:tutors.length+1,id,name,username,pass,mapel,level,status,catatan});
  }
  await DB.set('tutors',tutors);
  closeModal();
  showToast(existingId?'Data tutor diperbarui ✅':'Tutor baru ditambahkan ✅','ok');
  loadTutor();
}

