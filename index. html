};

const firebaseApp = initializeApp(firebaseConfig);
const database = getDatabase(firebaseApp);

// Cache lokal agar UI tetap responsif
const _cache = {};
// Listener aktif
const _listeners = {};

// DB async — semua operasi kini async
const DB = {
  // Baca dari cache (sinkron, untuk render cepat)
  get(k){ return _cache[k] !== undefined ? _cache[k] : null; },

  // Tulis ke Firebase + update cache
  async set(k, v){
    _cache[k] = v;
    try {
      await set(ref(database, 'et/' + k), v);
    } catch(e) {
      console.error('Firebase set error:', e);
      showToast('Gagal menyimpan ke server: ' + e.message, 'err');
    }
  },

  // Subscribe real-time untuk satu key
  subscribe(k, cb){
    if(_listeners[k]) { off(ref(database,'et/'+k)); }
    const r = ref(database, 'et/' + k);
    _listeners[k] = onValue(r, snap => {
      const val = snap.val();
      _cache[k] = val;
      if(cb) cb(val);
    });
  },

  // Baca sekali dari Firebase
  async fetch(k){
    try {
      const snap = await get(ref(database, 'et/' + k));
      const val = snap.val();
      _cache[k] = val;
      return val;
    } catch(e) {
      console.error('Firebase fetch error:', e);
      return null;
    }
  },

  // Init: cek apakah DB sudah ada di Firebase, jika belum isi SEED
  async init(){
    document.getElementById('page-login').innerHTML += '<div id="fb-loading" style="position:absolute;inset:0;background:rgba(13,31,51,.85);display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:24px;z-index:10"><div class="spinner" style="border-top-color:#5DCAA5"></div><div style="color:#fff;font-size:13px;margin-top:12px">Menghubungkan ke server...</div></div>';
    try {
      const snap = await get(ref(database, 'et/init'));
      if(!snap.exists() || !snap.val()){
        showToast('Inisialisasi data awal...', '');
        await set(ref(database,'et/tutors'), SEED.tutors);
        await set(ref(database,'et/siswa'),  SEED.siswa);
        await set(ref(database,'et/tarif'),  SEED.tarif);
        await set(ref(database,'et/absensi'), SEED.absensi);
        await set(ref(database,'et/pembayaran'), []);
        await set(ref(database,'et/init'), true);
      }
      // Load semua ke cache
      const keys = ['tutors','siswa','tarif','absensi','pembayaran'];
      await Promise.all(keys.map(k => this.fetch(k)));
    } catch(e) {
      console.error('Init error:', e);
      showToast('Gagal terhubung ke Firebase: ' + e.message, 'err');
    } finally {
      document.getElementById('fb-loading')?.remove();
    }
  }
};

