<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>EduTrack — Bee Smart Course</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
:root{
  --navy:#1A3557;--teal:#0F6E56;--amber:#854F0B;--red:#A32D2D;
  --navy-light:#E6F1FB;--teal-light:#EAF3DE;--amber-light:#FAEEDA;--red-light:#FCEBEB;
  --bg:#F4F6F9;--surface:#fff;--border:#E8ECF2;
  --text:#1A1F2E;--text-2:#6B7280;--text-3:#9CA3AF;
  --radius:12px;--radius-sm:8px;--radius-lg:18px;
  --shadow:0 1px 8px rgba(0,0,0,.06),0 4px 16px rgba(0,0,0,.04);
  --nav-h:64px;
  --font:'Plus Jakarta Sans',sans-serif;
  --mono:'DM Mono',monospace;
}
html,body{height:100%;overflow:hidden}
body{font-family:var(--font);background:var(--bg);color:var(--text);font-size:14px;line-height:1.5}
.hidden{display:none!important}
input,select,textarea,button{font-family:var(--font)}
.scroll{overflow-y:auto;-webkit-overflow-scrolling:touch}
.scroll::-webkit-scrollbar{width:4px}
.scroll::-webkit-scrollbar-thumb{background:#d1d5db;border-radius:2px}

/* ── LOGIN ── */
#page-login{
  min-height:100vh;display:flex;align-items:center;justify-content:center;
  background:linear-gradient(145deg,#0d1f33 0%,#1A3557 45%,#0F6E56 100%);
  padding:20px;position:relative;overflow:hidden;
}
#page-login::before{
  content:'';position:absolute;width:600px;height:600px;
  border-radius:50%;background:rgba(255,255,255,.03);
  top:-200px;right:-200px;
}
#page-login::after{
  content:'';position:absolute;width:400px;height:400px;
  border-radius:50%;background:rgba(15,110,86,.15);
  bottom:-100px;left:-100px;
}
.login-box{
  background:rgba(255,255,255,.97);border-radius:24px;
  padding:40px 32px;width:100%;max-width:400px;
  box-shadow:0 32px 80px rgba(0,0,0,.3);position:relative;z-index:1;
}
.login-header{text-align:center;margin-bottom:32px}
.login-logo-wrap{
  width:72px;height:72px;border-radius:20px;
  background:linear-gradient(135deg,#1A3557,#0F6E56);
  display:flex;align-items:center;justify-content:center;
  margin:0 auto 16px;font-size:32px;
}
.login-header h1{font-size:22px;font-weight:700;color:var(--navy);letter-spacing:-.3px}
.login-header p{font-size:12px;color:var(--text-3);margin-top:4px}
.login-err{
  background:var(--red-light);color:var(--red);
  padding:10px 14px;border-radius:10px;font-size:13px;
  margin-bottom:16px;border-left:3px solid var(--red);
}
.field{margin-bottom:16px}
.field label{display:block;font-size:12px;font-weight:600;color:var(--text-2);margin-bottom:6px;letter-spacing:.3px;text-transform:uppercase}
.inp{
  width:100%;padding:12px 16px;border:1.5px solid var(--border);
  border-radius:10px;font-size:14px;outline:none;background:#fafafa;
  transition:all .2s;color:var(--text);
}
.inp:focus{border-color:var(--navy);background:#fff;box-shadow:0 0 0 4px rgba(26,53,87,.08)}
.btn-login{
  width:100%;background:linear-gradient(135deg,#1A3557,#0F6E56);
  color:#fff;border:none;border-radius:12px;
  padding:14px;font-size:15px;font-weight:600;
  cursor:pointer;margin-top:4px;
  letter-spacing:.3px;transition:all .2s;
}
.btn-login:hover{opacity:.9;transform:translateY(-1px)}
.btn-login:active{transform:scale(.98)}
.login-hint{margin-top:16px;font-size:11px;color:var(--text-3);text-align:center}
.login-hint span{
  display:inline-block;background:#f0f2f5;
  padding:4px 10px;border-radius:6px;font-family:var(--mono);
  font-size:10px;color:var(--text-2);margin:2px;
}

/* ── APP SHELL ── */
#page-app{display:flex;flex-direction:column;height:100vh}
.topbar{
  background:var(--navy);color:#fff;
  height:56px;padding:0 20px;
  display:flex;align-items:center;justify-content:space-between;
  flex-shrink:0;z-index:50;
  box-shadow:0 2px 8px rgba(0,0,0,.15);
}
.topbar-brand{display:flex;align-items:center;gap:10px}
.topbar-icon{
  width:32px;height:32px;border-radius:8px;
  background:rgba(255,255,255,.15);
  display:flex;align-items:center;justify-content:center;font-size:16px;
}
.topbar-name{font-size:15px;font-weight:700;letter-spacing:-.2px}
.topbar-right{display:flex;align-items:center;gap:8px}
.user-chip{
  display:flex;align-items:center;gap:8px;
  background:rgba(255,255,255,.12);
  border-radius:20px;padding:4px 12px 4px 4px;cursor:pointer;
}
.avatar{
  width:28px;height:28px;border-radius:50%;
  background:linear-gradient(135deg,#5DCAA5,#0F6E56);
  display:flex;align-items:center;justify-content:center;
  font-size:11px;font-weight:700;color:#fff;flex-shrink:0;
}
.uname{font-size:12px;font-weight:500}
.btn-logout{
  background:none;border:1px solid rgba(255,255,255,.25);
  color:rgba(255,255,255,.8);font-size:11px;
  cursor:pointer;padding:5px 12px;border-radius:8px;
  transition:.15s;
}
.btn-logout:hover{background:rgba(255,255,255,.1)}

.app-body{flex:1;overflow:hidden;display:flex}

/* ── SIDEBAR ── */
.sidebar{
  width:220px;background:var(--surface);
  border-right:1px solid var(--border);
  flex-shrink:0;display:flex;flex-direction:column;
  padding:12px 0;overflow-y:auto;
}
.sidebar-section{
  font-size:10px;font-weight:700;color:var(--text-3);
  text-transform:uppercase;letter-spacing:.8px;
  padding:16px 20px 6px;
}
.s-item{
  display:flex;align-items:center;gap:10px;
  padding:10px 16px;cursor:pointer;
  font-size:13px;color:var(--text-2);
  border-left:3px solid transparent;
  transition:all .15s;margin:1px 8px;
  border-radius:8px;border-left:none;
}
.s-item:hover{background:var(--bg);color:var(--navy)}
.s-item.active{background:var(--navy-light);color:var(--navy);font-weight:600}
.s-item.active .s-icon-wrap{background:var(--navy);color:#fff}
.s-icon-wrap{
  width:30px;height:30px;border-radius:8px;
  background:var(--bg);
  display:flex;align-items:center;justify-content:center;
  font-size:15px;flex-shrink:0;transition:.15s;
}
.sidebar-footer{
  margin-top:auto;padding:12px 16px;
  border-top:1px solid var(--border);
  font-size:11px;color:var(--text-3);
}

/* ── MAIN ── */
.main-scroll{
  flex:1;overflow-y:auto;padding:20px;
  background:var(--bg);
}
.main-scroll::-webkit-scrollbar{width:4px}
.main-scroll::-webkit-scrollbar-thumb{background:#d1d5db;border-radius:2px}

/* ── BOTTOM NAV (mobile) ── */
.bottom-nav{
  position:fixed;bottom:0;left:0;right:0;
  height:var(--nav-h);background:var(--surface);
  border-top:1px solid var(--border);
  display:grid;z-index:100;
  padding-bottom:env(safe-area-inset-bottom);
  box-shadow:0 -4px 12px rgba(0,0,0,.06);
}
.nav-item{
  display:flex;flex-direction:column;align-items:center;
  justify-content:center;gap:3px;cursor:pointer;
  padding:8px 4px 4px;position:relative;transition:.15s;
}
.nav-icon{font-size:20px;line-height:1}
.nav-label{font-size:9px;color:var(--text-3);font-weight:500;transition:.15s}
.nav-item.active .nav-label{color:var(--navy);font-weight:700}
.nav-item.active::before{
  content:'';position:absolute;top:0;left:20%;right:20%;
  height:3px;background:var(--navy);border-radius:0 0 3px 3px;
}

/* ── CARDS & LAYOUT ── */
.page-header{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:20px;flex-wrap:wrap;gap:12px;
}
.page-title{font-size:20px;font-weight:700;color:var(--navy);letter-spacing:-.3px}
.page-sub{font-size:13px;color:var(--text-3);margin-top:2px}
.card{
  background:var(--surface);border-radius:var(--radius);
  box-shadow:var(--shadow);padding:20px;margin-bottom:16px;
  border:1px solid var(--border);
}
.card-title{
  font-size:14px;font-weight:700;color:var(--navy);
  margin-bottom:16px;
  display:flex;align-items:center;justify-content:space-between;gap:8px;
}
.card-title-left{display:flex;align-items:center;gap:8px}
.card-icon{
  width:34px;height:34px;border-radius:9px;
  display:flex;align-items:center;justify-content:center;
  font-size:16px;flex-shrink:0;
}
.ci-navy{background:var(--navy-light)}
.ci-teal{background:var(--teal-light)}
.ci-amber{background:var(--amber-light)}
.ci-red{background:var(--red-light)}

/* ── STATS GRID ── */
.stats-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
  gap:12px;margin-bottom:20px;
}
.stat-card{
  background:var(--surface);border-radius:var(--radius);
  box-shadow:var(--shadow);padding:16px 18px;
  border:1px solid var(--border);
  border-top:3px solid var(--navy);
  transition:transform .15s;
}
.stat-card:hover{transform:translateY(-2px)}
.stat-card.t{border-top-color:var(--teal)}
.stat-card.a{border-top-color:#D97706}
.stat-card.r{border-top-color:var(--red)}
.stat-label{font-size:11px;color:var(--text-3);text-transform:uppercase;letter-spacing:.6px;margin-bottom:8px;font-weight:600}
.stat-val{font-size:26px;font-weight:700;color:var(--navy);line-height:1;letter-spacing:-.5px}
.stat-val.sm{font-size:16px;padding-top:4px;font-family:var(--mono)}
.stat-sub{font-size:11px;color:var(--text-3);margin-top:4px}

/* ── BADGES ── */
.badge{
  display:inline-flex;align-items:center;
  padding:3px 10px;border-radius:20px;
  font-size:11px;font-weight:600;white-space:nowrap;
}
.bg-green{background:#DCFCE7;color:#166534}
.bg-blue{background:var(--navy-light);color:#0C447C}
.bg-amber{background:var(--amber-light);color:var(--amber)}
.bg-red{background:var(--red-light);color:var(--red)}
.bg-gray{background:#F3F4F6;color:#4B5563}
.bg-teal{background:var(--teal-light);color:var(--teal)}
.bg-purple{background:#EDE9FE;color:#5B21B6}

/* ── BUTTONS ── */
.btn{
  display:inline-flex;align-items:center;gap:6px;
  padding:9px 16px;border-radius:9px;border:none;
  cursor:pointer;font-size:13px;font-weight:600;
  transition:all .15s;font-family:var(--font);
}
.btn:active{transform:scale(.97)}
.btn-primary{background:var(--navy);color:#fff}
.btn-primary:hover{background:#122640}
.btn-teal{background:var(--teal);color:#fff}
.btn-teal:hover{background:#0a5040}
.btn-amber{background:#D97706;color:#fff}
.btn-red{background:var(--red);color:#fff}
.btn-outline{background:var(--surface);color:var(--navy);border:1.5px solid var(--border)}
.btn-outline:hover{background:var(--bg);border-color:var(--navy)}
.btn-ghost{background:transparent;color:var(--text-2);border:none;padding:6px 10px}
.btn-ghost:hover{background:var(--bg);color:var(--navy)}
.btn-sm{padding:6px 12px;font-size:12px;border-radius:7px}
.btn-xs{padding:4px 8px;font-size:11px;border-radius:6px}
.btn-icon{width:32px;height:32px;padding:0;justify-content:center;border-radius:8px}

/* ── FORMS ── */
.form-group{display:flex;flex-direction:column;gap:5px}
.form-group label{font-size:11px;font-weight:700;color:var(--text-2);text-transform:uppercase;letter-spacing:.4px}
.form-control{
  padding:10px 14px;border:1.5px solid var(--border);
  border-radius:9px;font-size:13px;background:#fafafa;
  outline:none;transition:all .2s;color:var(--text);
  font-family:var(--font);
}
.form-control:focus{border-color:var(--navy);background:#fff;box-shadow:0 0 0 3px rgba(26,53,87,.08)}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.form-grid .full{grid-column:1/-1}
.filter-bar{
  display:flex;gap:10px;flex-wrap:wrap;
  align-items:flex-end;
  padding:16px;background:var(--bg);
  border-radius:10px;margin-bottom:16px;
}

/* ── TABLE ── */
.table-wrap{overflow-x:auto;margin:0 -20px;padding:0 20px}
.tbl{width:100%;border-collapse:collapse;font-size:13px;min-width:500px}
.tbl th{
  background:#F8FAFC;color:var(--text-2);
  padding:10px 14px;text-align:left;
  font-weight:600;font-size:11px;
  text-transform:uppercase;letter-spacing:.4px;
  border-bottom:1.5px solid var(--border);white-space:nowrap;
}
.tbl td{
  padding:12px 14px;border-bottom:1px solid #F0F2F5;
  vertical-align:middle;
}
.tbl tr:last-child td{border-bottom:none}
.tbl tbody tr:hover td{background:#FAFBFE}
.tbl tfoot td{
  background:#F8FAFC;font-weight:700;
  color:var(--navy);border-top:2px solid var(--border);
}

/* ── LIST ITEMS ── */
.item-list{display:flex;flex-direction:column;gap:8px}
.item{
  background:var(--surface);border:1px solid var(--border);
  border-radius:10px;padding:14px 16px;
  display:flex;align-items:center;gap:12px;
  transition:all .15s;
}
.item:hover{border-color:var(--navy);box-shadow:0 2px 8px rgba(26,53,87,.08)}
.item-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0}
.dot-hadir{background:#16A34A}
.dot-izin{background:#D97706}
.dot-alpha{background:var(--red)}
.dot-libur{background:#9CA3AF}
.item-body{flex:1;min-width:0}
.item-title{font-size:13px;font-weight:600;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.item-meta{font-size:11px;color:var(--text-3);margin-top:2px}
.item-right{flex-shrink:0;text-align:right}

/* ── KOMISI BANNER ── */
.komisi-banner{
  background:linear-gradient(135deg,#1A3557 0%,#0F6E56 100%);
  border-radius:var(--radius);padding:24px;
  color:#fff;margin-bottom:16px;
  display:flex;align-items:center;justify-content:space-between;
  flex-wrap:wrap;gap:16px;
}
.k-left .k-label{font-size:12px;opacity:.75;margin-bottom:6px}
.k-left .k-val{font-size:32px;font-weight:700;letter-spacing:-1px;font-family:var(--mono)}
.k-left .k-sub{font-size:11px;opacity:.6;margin-top:4px}
.k-chips{display:flex;gap:8px;flex-wrap:wrap}
.k-chip{
  background:rgba(255,255,255,.15);
  border-radius:8px;padding:8px 14px;text-align:center;
}
.k-chip-num{font-size:20px;font-weight:700}
.k-chip-lbl{font-size:10px;opacity:.7;margin-top:2px}

/* ── MODAL / SHEET ── */
.overlay{
  position:fixed;inset:0;background:rgba(0,0,0,.5);
  z-index:500;display:flex;align-items:flex-end;
  opacity:0;pointer-events:none;transition:opacity .25s;
}
.overlay.open{opacity:1;pointer-events:auto}
.modal-box{
  background:var(--surface);border-radius:22px 22px 0 0;
  width:100%;max-height:92vh;overflow-y:auto;
  padding:0 24px 32px;
  transform:translateY(100%);
  transition:transform .3s cubic-bezier(.32,.72,0,1);
}
.overlay.open .modal-box{transform:translateY(0)}
.modal-handle{
  width:40px;height:4px;background:var(--border);
  border-radius:2px;margin:14px auto 20px;
}
.modal-title{
  font-size:17px;font-weight:700;color:var(--navy);
  margin-bottom:20px;display:flex;align-items:center;gap:10px;
}
.form-actions{display:flex;gap:10px;margin-top:20px}
.form-actions .btn{flex:1;justify-content:center;padding:13px}

@media(min-width:768px){
  .overlay{align-items:center;justify-content:center}
  .modal-box{
    max-width:560px;border-radius:16px;
    max-height:90vh;transform:scale(.95);
  }
  .overlay.open .modal-box{transform:scale(1)}
  .bottom-nav{display:none}
  .main-scroll{padding:24px 28px;padding-bottom:24px}
}

/* ── TOAST ── */
.toast{
  position:fixed;bottom:calc(var(--nav-h) + 12px);left:50%;
  transform:translateX(-50%);
  background:#1E293B;color:#fff;
  padding:12px 20px;border-radius:20px;
  font-size:13px;font-weight:500;z-index:999;
  white-space:nowrap;box-shadow:0 4px 24px rgba(0,0,0,.25);
  transition:opacity .3s;display:flex;align-items:center;gap:8px;
}
.toast.ok{background:#0F6E56}
.toast.err{background:var(--red)}
@media(min-width:768px){.toast{bottom:24px}}

/* ── SPINNER ── */
.spinner{
  width:32px;height:32px;border:3px solid var(--border);
  border-top-color:var(--navy);border-radius:50%;
  animation:spin .7s linear infinite;margin:32px auto;
}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.empty{text-align:center;padding:40px;color:var(--text-3);font-size:13px}
.empty-icon{font-size:40px;margin-bottom:8px}

/* ── PHOTO UPLOAD ── */
.photo-drop{
  border:2px dashed var(--border);border-radius:12px;
  padding:20px;text-align:center;background:#fafafa;
  cursor:pointer;transition:all .2s;
}
.photo-drop:hover{border-color:var(--navy);background:var(--navy-light)}
.photo-drop.has-photo{padding:12px}
.photo-thumb{max-height:120px;border-radius:8px;margin-bottom:8px}

/* ── RESPONSIVE HIDE ── */
@media(min-width:768px){
  .main-scroll{padding-bottom:24px}
  .sidebar{display:flex}
}
@media(max-width:767px){
  .sidebar{display:none}
  select,input[type="date"],input[type="number"],input[type="text"]{font-size:16px!important}
  .btn{min-height:40px}
}

/* ── TARIF GRID ── */
.tarif-matrix{display:grid;grid-template-columns:auto repeat(4,1fr);gap:6px;font-size:12px;margin-bottom:10px}
.tmat-h{
  background:var(--navy);color:#fff;
  border-radius:6px;padding:6px 8px;
  text-align:center;font-weight:600;font-size:11px;
}
.tmat-lbl{
  background:var(--bg);border-radius:6px;
  padding:6px 10px;font-weight:600;
  font-size:11px;color:var(--text-2);
  display:flex;align-items:center;
}
.tmat-val{
  background:var(--navy-light);border-radius:6px;
  padding:6px;text-align:center;
  font-family:var(--mono);font-size:11px;
  color:var(--navy);font-weight:500;
}

/* ── LEVEL CARDS ── */
.level-cards{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));
  gap:10px;margin-bottom:16px;
}
.level-card{
  border-radius:10px;padding:14px;
  border:1px solid var(--border);background:var(--surface);
  border-top:3px solid;
}
.lc-tk{border-top-color:#E65100}
.lc-sd{border-top-color:#0F6E56}
.lc-smp{border-top-color:#185FA5}
.lc-sma{border-top-color:#854F0B}
.lc-label{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px}
.lc-tk .lc-label{color:#E65100}
.lc-sd .lc-label{color:#0F6E56}
.lc-smp .lc-label{color:#185FA5}
.lc-sma .lc-label{color:#854F0B}
.lc-val{font-size:15px;font-weight:700;font-family:var(--mono);color:var(--text);margin-bottom:4px}
.lc-sub{font-size:10px;color:var(--text-3)}

/* ── SEARCH BAR ── */
.search-wrap{position:relative;flex:1;min-width:180px}
.search-wrap input{padding-left:36px}
.search-icon{
  position:absolute;left:12px;top:50%;transform:translateY(-50%);
  font-size:14px;color:var(--text-3);pointer-events:none;
}

/* ── AVATAR CIRCLE ── */
.av-circle{
  width:36px;height:36px;border-radius:50%;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
  font-size:14px;font-weight:700;color:#fff;
}
</style>
</head>
<body>

<!-- ══ LOGIN ═══════════════════════════════════════════════════════════════ -->
<div id="page-login">
  <div class="login-box">
    <div class="login-header">
      <div class="login-logo-wrap">🐝</div>
      <h1>Bee Smart Course</h1>
      <p>EduTrack — Sistem Rekap Bimbingan Belajar</p>
    </div>
    <div id="login-err" class="login-err hidden"></div>
    <div class="field">
      <label>Username</label>
